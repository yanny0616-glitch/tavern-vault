{
  "name": "tavern-vault-desktop",
  "version": "1.0.3",
  "private": true,
  "description": "卡匣 Windows 桌面版外壳（Electron）",
  "author": "Cardbox",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "app.cardbox.desktop",
    "productName": "卡匣",
    "files": ["main.js", "preload.js", "launcher.html", "build/icon.png"],
    "directories": { "output": "dist" },
    "win": { "target": "nsis", "icon": "build/icon.png" },
    "nsis": {
      "artifactName": "Cardbox-Setup-${version}.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": ["zh_CN"],
      "language": "2052",
      "shortcutName": "卡匣",
      "uninstallDisplayName": "卡匣",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
